# 🔥 CORE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
APIFY_TOKEN=YOUR_APIFY_TOKEN
USDA_API_KEY=YOUR_USDA_API_KEY
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json

# 🌍 BACKEND
BACKEND_BASE_URL=https://ton-backend.railway.app
APP_ENV=development
PORT=3000
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# 🤖 OPENAI MODELS
OPENAI_RECIPE_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# 📱 APIFY ACTORS
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-api-scraper
APIFY_PINTEREST_ACTOR_ID=devcake/pinterest-pin-scraping

# 💎 REVENUECAT
# Shared secret configured in the RevenueCat dashboard → Project → Apps
# → Webhooks. Must match the Authorization header RevenueCat sends.
REVENUECAT_WEBHOOK_SECRET=YOUR_REVENUECAT_WEBHOOK_SECRET